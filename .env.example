PORT=4000
MONGODB_URI=mongodb://localhost:27017/ai-study-hub
JWT_SECRET=change-this-secret
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
MOBILE_APP_SCHEME=aistudyhub
# Set true only when testing payments from Expo Go against a production backend.
# Release/dev-client builds use aistudyhub:// and do not need this flag.
ALLOW_EXPO_GO_RETURN_URL=false
TRASH_RETENTION_DAYS=30
JOB_SECRET=replace-with-a-long-random-secret
PINECONE_DELETE_RETRY_COUNT=3
PINECONE_DELETE_RETRY_DELAY_MS=250

# Render Free blocks SMTP ports 25, 465, and 587. SendGrid supports STARTTLS on 2525.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=AI Study Hub <your-verified-sender@example.com>
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_REQUIRED=false

# Optional. Defaults to JWT_SECRET and encrypts resendable invitation tokens at rest.
INVITATION_TOKEN_SECRET=replace-with-a-long-random-secret

# Cloudinary stores the raw uploaded files. The free plan caps raw files at 10 MB,
# which is why upload.middleware.ts enforces the same limit.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage packages and payment.
PAYMENT_PROVIDER=PAYOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PayOS webhook: https://<api-origin>/api/storage/payments/payos/webhook
# Absolute public origin of THIS api. PayOS return/cancel/webhook URLs must be
# publicly reachable HTTPS URLs in production.
PUBLIC_API_URL=http://localhost:4000
STORAGE_ORDER_TTL_MINUTES=15
# Set to false to disable quota enforcement without a redeploy.
STORAGE_QUOTA_ENFORCED=true

# BYOK Credentials & Quota Configuration
# Boot-critical secret: 32-byte Base64 string required for AES-256-GCM encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIAL_ENCRYPTION_KEY=

# Set to true to enable weekly free-tier capping (default 15 prompts/week per
# RULE-01). Counts chat, agent and document-summarize prompts against one
# shared counter. Default is false.
ENFORCE_BYOK_QUOTA=false
FREE_TIER_WEEKLY_MESSAGES=15
